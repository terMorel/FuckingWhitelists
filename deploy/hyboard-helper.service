[Unit]
Description=Fucking Whitelists Control privileged broker
After=local-fs.target
Before=hyboard.service

[Service]
Type=simple
User=root
Group=hyboard
UMask=0007
RuntimeDirectory=hyboard
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/local/libexec/hyboard-helperd
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/hysteria /root/hysteria-access /run/hyboard
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target

