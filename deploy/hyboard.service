[Unit]
Description=Fucking Whitelists Control
After=network.target

[Service]
Type=simple
User=hyboard
Group=hyboard
EnvironmentFile=/etc/hyboard/hyboard.env
WorkingDirectory=/var/lib/hyboard
ExecStart=/opt/hyboard/.venv/bin/hyboard
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hyboard
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
